{
  "name": "mcp-toolkit",
  "version": "0.3.3",
  "private": true,
  "description": "TypeScript middleware toolkit for MCP servers - authentication, caching, rate limiting, CORS, logging (beta)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "build:integration": "tsc -p tsconfig.integration.json",
    "test:e2e": "npm run build:integration && node --test \"build/test/**/*.test.js\"",
    "bench": "npm run build:integration && node build/bench/overhead.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "middleware",
    "auth",
    "cache",
    "rate-limit",
    "logger",
    "cors"
  ],
  "author": "Sagar Gupta",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^25.3.5",
    "hono": "^4.13.13",
    "redis": "^6.3.0",
    "typescript": "^7.0.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "fast-uri": "^4.0.0",
    "ip-address": "^10.3.1"
  }
}
